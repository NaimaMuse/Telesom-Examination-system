# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/telesom_exam_db

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256

# Google OAuth Web client ID. Add the frontend origin under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Production only. Use an HTTPS reverse proxy and put the app and /api on the same site.
# FRONTEND_ORIGINS=https://academy.example.com
# TRUST_PROXY=127.0.0.1
# REQUIRE_HTTPS=true
# MONGO_REQUIRE_TLS=true
